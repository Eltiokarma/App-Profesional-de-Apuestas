# ── Fuente de datos de la app ─────────────────────────────────────────────
# mock : motor local determinista (demo, no requiere backend)  ← default
# http : backend SAD real (FastAPI + PostgreSQL)
VITE_DATA_SOURCE=mock

# ── Backend SAD (solo aplica con VITE_DATA_SOURCE=http) ───────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Token bearer SOLO para entornos de desarrollo/staging.
# Debe coincidir con SAD_API_TOKEN del backend (ver backend/README.md).
# ⚠ Todo VITE_* queda embebido en el bundle (visible para cualquiera):
#   en producción la autenticación debe ser de sesión gestionada por el
#   backend, y la clave de API-Football NUNCA va en el frontend.
VITE_API_KEY=

# ── Tokens del backend (NO llevan prefijo VITE_: no van al bundle) ────────
# SAD_API_TOKEN     llave maestra. Abre todo, incluido lo que gasta dinero
#                   (/analisis/efe|timeline|dtp queman créditos de Claude;
#                   vip y refrescar pueden tirar de SAD_EMERGENCIA_KEY, que
#                   factura excedente de API-Football).
# SAD_TOKEN_COWORK  token ACOTADO para Cowork: solo la superficie del parte
#                   (sin DELETE) y las lecturas del pipeline. Ponlo DISTINTO
#                   del maestro; si es igual no recorta nada y se ignora.
#                   Ver docs/COWORK.md.
SAD_API_TOKEN=
SAD_TOKEN_COWORK=

# ── Intervalos (ms) ────────────────────────────────────────────────────────
VITE_POLL_HEALTH_MS=30000
VITE_POLL_LIVE_MS=60000

# ── Extractor de ingesta (backend/ingesta/extractor.py) ───────────────────
# Clave de API-Football directo (dashboard.api-football.com). NO lleva
# prefijo VITE_ a propósito:
# solo la lee el extractor Python; nunca se embebe en el frontend.
API_FOOTBALL_KEY=

# Respaldo de emergencia: la MISMA API-Football vía RapidAPI (suscribirse a
# "API-Football" en rapidapi.com; plan Basic gratis ~100 req/día). SOLO se usa
# cuando el plan principal agota su cuota diaria; opcional.
RAPIDAPI_KEY=
# Tope diario del respaldo si sus cabeceras no lo enseñan (default 95).
# SAD_RAPIDAPI_LIMITE=95
